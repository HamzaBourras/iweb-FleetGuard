# ==============================================================================
# CONFIGURATION DE L'ENVIRONNEMENT - IWEB FLEETGUARD
# Renommez ce fichier en ".env" et remplissez les valeurs avec vos propres clés.
# Ne commitez jamais le fichier ".env" réel dans le gestionnaire de versions.
# ==============================================================================

# --- Configuration de l'application ---
BACKEND_URL=http://localhost:8000
FRONTEND_URL=http://localhost:5173
COOKIE_SECURE=false
ALLOW_INSECURE_HTTP=false
SOC_PUBLIC_URL=https://soc.exemple.com

# --- Base de données PostgreSQL ---
POSTGRES_USER=fleetguard_admin
POSTGRES_PASSWORD=remplacer_par_un_mot_de_passe_robuste
POSTGRES_DB=fleetguard_db

# --- Sécurité & Chiffrement ---
# Clé Fernet (32 octets encodés en Base64 URL-safe) pour chiffrer les tokens en BDD
ENCRYPTION_KEY=remplacer_par_une_cle_fernet_valide_ici
JWT_SECRET_KEY=exécuter_la_commande : python -c "import secrets; print(secrets.token_urlsafe(64))"
ENCRYPTION_KEY_OLD=

# --- Configuration Serveur SMTP (Notifications) ---
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=alerte-soc@votre-domaine.com
SMTP_PASSWORD=remplacer_par_le_mot_de_passe_d_application
SENDER_EMAIL=alerte-soc@votre-domaine.com

# --- Destinataire des alertes SOC ---
SOC_ALERT_EMAIL=admin_securite@votre-agence.com